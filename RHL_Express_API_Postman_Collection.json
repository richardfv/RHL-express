							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.id) {",
									"    pm.collectionVariables.set(\"envioId\", jsonData.id);",
									"}",
									"if (jsonData.codigoTracking) {",
									"    pm.collectionVariables.set(\"trackingCode\", jsonData.codigoTracking);",
									"    console.log(\"Nuevo tracking generado:\", jsonData.codigoTracking);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
